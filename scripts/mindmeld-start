#!/bin/sh
set -e

# the web ui's supervisor lock lives in the home volume; after a restart its pid can belong to
# an unrelated process, and the web ui then refuses to start
rm -rf ~/.config/herdr-web-ui/updates/*/supervisor.lock

# sshd's host key lives in ~/.sshd, in the home volume: it survives restarts, and ~/.ssh stays
# free for a read-only mount of the host's own ssh dir (logins read ~/.ssh/authorized_keys as usual)
mkdir -p -m 700 ~/.sshd
[ -f ~/.sshd/ssh_host_ed25519_key ] || ssh-keygen -q -t ed25519 -N '' -f ~/.sshd/ssh_host_ed25519_key

# ponytail: sshd daemonizes under tini and isn't restarted if it dies; restart the container
/usr/sbin/sshd -f /etc/ssh/mindmeld_sshd_config

# herdr remote/saved machines refuse a server that isn't its own session leader, so setsid it
# and forward docker stop's SIGTERM so it still saves the session on shutdown
setsid herdr server &
pid=$!

trap 'kill -TERM $pid' TERM INT
wait $pid || wait $pid
